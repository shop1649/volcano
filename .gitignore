# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# user-local settings / secrets (see local.example.yaml)
local.yaml
cookies*.txt
*.cookies

# heavy media: downloaded / generated (provenance is tracked in json/jsonl, not the media)
warehouse/sources/
warehouse/cache/
presets/*/reference/videos/
presets/*/analysis/*/frames/
presets/*/analysis/*/stems/
presets/*/analysis/*/*.wav
assets/fonts/*.ttf
assets/fonts/*.otf
assets/fonts/*.ttc
assets/library/music/*
assets/library/sfx/*
!assets/library/music/README.md
!assets/library/sfx/README.md
assets/test/generated/
episodes/*/build/
episodes/*/qa/frames/
*.tmp.*

# OS
.DS_Store
Thumbs.db

# absolute-path project variants (local import only) and regenerable project media
episodes/*/project/*.local.fcpxml
episodes/*/project/media/
episodes/*/output/*.ffmpeg.log
# per-event SFX fingerprints (regenerable). Catalog centroids presets/*/sfx_fp/*.npy stay tracked.
presets/*/analysis/*/audio/sfx_fp/
# synthetic QA test episodes (regenerated by tests/qa) and crops of third-party footage
episodes/test-qa-*/
warehouse/overlays/*/
presets/*/analysis/*/lens/*.jpg
presets/*/analysis/*/review/*.jpg
