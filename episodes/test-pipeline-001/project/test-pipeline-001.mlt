    <filter id="filter28">
      <property name="mlt_service">avfilter.subtitles</property>
      <property name="av.filename">captions.ass</property>
      <property name="av.fontsdir">../build/fonts</property>
      <property name="shortkit:role">captions+decorations (one ASS layer, same file as the master)</property>
    </filter>
    <filter id="filter29">
      <property name="mlt_service">volume</property>
      <property name="level">-0.067</property>
      <property name="shotcut:filter">audioGain</property>
      <property name="shortkit:role">loudness normalization gain (master render)</property>
    </filter>
